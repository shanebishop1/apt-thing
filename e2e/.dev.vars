# End-to-end test fixture only. These values are read by the local Cloudflare dev bridge when
# `APT_WRANGLER_CONFIG=e2e/wrangler.e2e.jsonc`. They are not secrets: the invite code is a dummy
# used by the Playwright suite, and the provider keys are deliberately blank so extraction falls
# back to manual-review records instead of calling a real provider.
GROUP_INVITE_CODES="nyc-5br-2026=e2e-invite-code-0123456789abcdef"
GEMINI_API_KEY=""
REALTYAPI_KEY=""
STADIA_MAPS_API_KEY=""
