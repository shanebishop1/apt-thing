{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "jsx-a11y", "nextjs"],
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "settings": {
    "next": {
      "rootDir": "."
    }
  },
  "ignorePatterns": [
    ".next/**",
    ".open-next/**",
    ".wrangler/**",
    "coverage/**",
    "node_modules/**",
    "worker-configuration.d.ts"
  ]
}
