{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apt-thing",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apt-thing-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "RAW_ARTIFACTS",
      "bucket_name": "apt-thing-raw-artifacts",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "APP_CACHE",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000",
    },
  ],
  "vars": {
    "NEXTJS_ENV": "production",
    "APP_ENV": "local",
  },
  "triggers": {
    "crons": ["0 10 * * *"],
  },
  "workflows": [
    {
      "binding": "DAILY_SOURCE_AGENT_LOOP_WORKFLOW",
      "name": "daily-source-agent-loop",
      "class_name": "DailySourceAgentLoopWorkflow",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
