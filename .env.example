# Template for `cp .env.example .env`. Keep real values out of this file.
# `pnpm cf:types` reads this file, so keep these variable names in place.

# Diagnostic environment label. Not a security or provider-disable switch.
APP_ENV=local

# Server-only. Comma-separated groupId=inviteCode pairs, for example
# nyc-5br-2026=<code>. Codes shorter than 16 characters are ignored, and with no
# valid entry every protected route returns 503 group-auth-unconfigured.
# Generate a code with: openssl rand -hex 16
GROUP_INVITE_CODES=

# OpenNext build and runtime environment. Keep the production value.
NEXTJS_ENV=production

# Optional, server-only provider keys. Leaving them blank keeps the app on the
# manual-review path and makes no paid requests.
GEMINI_API_KEY=
REALTYAPI_KEY=
STADIA_MAPS_API_KEY=
