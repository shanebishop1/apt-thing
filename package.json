{
  "name": "apt-thing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint app src *.config.ts next.config.ts open-next.config.ts",
    "lint:fix": "oxlint --fix app src *.config.ts next.config.ts open-next.config.ts",
    "format": "oxfmt --write app src *.config.ts next.config.ts open-next.config.ts",
    "format:check": "oxfmt --check app src *.config.ts next.config.ts open-next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "proof:streeteasy": "node scripts/proof-streeteasy-realtyapi.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:client-secrets",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "pnpm cf:build && wrangler dev",
    "cf:types": "wrangler types --env-file .env.example",
    "cf:deploy:dry": "pnpm cf:build && wrangler deploy --dry-run",
    "cf:deploy": "pnpm cf:build && wrangler deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.15.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  },
  "engines": {
    "node": "22.15.1",
    "pnpm": "10.13.1"
  },
  "packageManager": "pnpm@10.13.1"
}
