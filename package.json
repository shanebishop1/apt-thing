{
  "name": "apt-thing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --deny-warnings app src scripts e2e *.config.ts",
    "lint:fix": "oxlint --fix app src scripts e2e *.config.ts",
    "format": "oxfmt --write app src scripts e2e *.config.ts",
    "format:check": "oxfmt --check app src scripts e2e *.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "proof:streeteasy": "node scripts/proof-streeteasy-realtyapi.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:client-secrets",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "pnpm cf:build && wrangler dev",
    "cf:types": "wrangler types --env-file .env.example",
    "cf:deploy:dry": "pnpm cf:build && wrangler deploy --dry-run",
    "cf:deploy": "pnpm cf:build && wrangler deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.132.0"
  },
  "engines": {
    "node": ">=22.15.1",
    "pnpm": "10.13.1"
  },
  "packageManager": "pnpm@10.13.1"
}
